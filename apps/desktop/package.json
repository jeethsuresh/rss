{
  "name": "@rss-reader/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first desktop RSS reader",
  "author": "Jeeth",
  "desktopName": "rss-reader",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeethsuresh/rss.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "bun build ./electron/main.ts --outdir ./dist-electron --target node --format esm --external electron && bun build ./electron/preload.ts --outdir ./dist-electron --target node --format cjs --external electron",
    "build": "bun run build:renderer && bun run build:electron",
    "test": "bun test",
    "lint": "echo 'desktop: ok'"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@rss-reader/shared": "workspace:*",
    "isomorphic-dompurify": "^3.22.0",
    "linkedom": "^0.18.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
